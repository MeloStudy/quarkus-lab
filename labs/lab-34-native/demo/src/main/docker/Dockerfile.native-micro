## The native executable on a tiny base image (no JVM inside).
## Build it from the root of the project, after "mvnw package -Dnative -Dquarkus.native.container-build=true":
##   docker build -f src/main/docker/Dockerfile.native-micro -t lab/native-demo:native .
FROM quay.io/quarkus/ubi9-quarkus-micro-image:2.0
WORKDIR /work/
RUN chown 1001 /work && chmod "g+rwX" /work && chown 1001:root /work
COPY --chown=1001:root --chmod=0755 target/*-runner /work/application

EXPOSE 8080
USER 1001

ENTRYPOINT ["./application", "-Dquarkus.http.host=0.0.0.0"]
